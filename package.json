  "description": "",
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "chrome-launcher": "^1.1.2",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "eslint-config-wesbos": "^4.3.2",
    "html_codesniffer": "^2.5.1",
    "lighthouse": "^12.3.0",
    "playwright": "^1.64.0"
  },
